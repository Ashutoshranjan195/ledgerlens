# LedgerLens Environment Configuration (Local Only)
# Note: LedgerLens works 100% offline without any API keys or network connection.

# Offline mode toggle: 1 enforces strict offline behavior (zero network attempts)
LEDGERLENS_OFFLINE=0

# Ollama local host URL (defaults to http://localhost:11434)
OLLAMA_HOST=http://localhost:11434

# Active model profile (fast | balanced | best)
LEDGERLENS_PROFILE=balanced

# Data directory override (leave empty to use standard OS user data dir)
LEDGERLENS_DATA_DIR=

# Optional Ed25519 commercial license key for unlimited exports (offline verified)
LEDGERLENS_LICENSE_KEY=
